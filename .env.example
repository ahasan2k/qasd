# Gateway keys your apps use (comma-separated). Leave empty only for local testing.
QASD_API_KEYS=change-me-app-key
# Sees stats for every key on the dashboard
QASD_ADMIN_KEY=change-me-admin-key

# Provider keys (bring your own; set only the ones you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# OLLAMA_API_BASE=http://host.docker.internal:11434

# Compaction: summarize old turns with a cheap model instead of a plain note (optional)
# QASD_SUMMARY_MODEL=claude-haiku-4-5
# QASD_COMPACT_TRIGGER_RATIO=0.7
# QASD_COMPACT_CHUNK=16

# Exact cache lifetime in seconds
# QASD_CACHE_TTL_SECONDS=3600

# Answer every request with this text instead of calling a provider (demos, benchmarks)
# QASD_MOCK_RESPONSE=ok
